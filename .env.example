# Copy to .env and edit values (do not commit .env).
#
# This project uses environment variables as the config contract so that:
# - local dev can load from a file
# - Docker Compose can use --env-file
# - Kubernetes / ECS can inject the same keys from Secrets / ConfigMaps

# ---- Kafka / Streaming ----
KAFKA_BOOTSTRAP=localhost:19092
INPUT_TOPIC=news_events_raw_v1
OUTPUT_TOPIC=news_events_v1
CANDIDATES_TOPIC=event_candidates_v1
CONSUMER_GROUP=news_normalize_job_v1
DEDUP_TTL_MINUTES=60

# Ports (override if you have conflicts)
MOCK_API_PORT=8000
REDPANDA_KAFKA_PORT=19092
REDPANDA_PROXY_PORT=18082
REDPANDA_ADMIN_PORT=9644
FLINK_UI_PORT=18081

# ---- Mock upstream API (ingest) ----
API_BASE_URL=http://localhost:8000

# ---- Postgres (dev: containerized, passwordless) ----
# Dev Postgres runs via Docker Compose using `infra/docker/docker-compose.pg.dev.yml`.
# It uses trust auth (no password). Do NOT use this setup in production.
#
# Enable/disable the Postgres sink in the Flink job:
PG_ENABLED=false

# Start dev env with: make dev-up (or make dev-smoke)
PG_PORT_LOCAL=15432
PG_JDBC_URL=jdbc:postgresql://postgres:5432/ai_ops
PG_USER=ai_ops
PG_PASSWORD=
PG_TABLE=event_candidates_v1
PG_BATCH_SIZE=1

# Host psql connects via mapped port:
PGHOST=localhost
PGPORT=15432
PGDATABASE=ai_ops
PGUSER=ai_ops
# PGPASSWORD=
