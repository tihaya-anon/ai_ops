# Copy to .env and edit values (do not commit .env).
#
# This project uses environment variables as the config contract so that:
# - local dev can load from a file
# - Docker Compose can use --env-file
# - Kubernetes / ECS can inject the same keys from Secrets / ConfigMaps

# ---- Kafka / Streaming ----
KAFKA_BOOTSTRAP=localhost:19092
INPUT_TOPIC=news_events_raw_v1
OUTPUT_TOPIC=news_events_v1
CANDIDATES_TOPIC=event_candidates_v1
CONSUMER_GROUP=news_normalize_job_v1
DEDUP_TTL_MINUTES=60

# ---- Mock upstream API (ingest) ----
API_BASE_URL=http://localhost:8000

# ---- Postgres (optional sink) ----
# For Flink running in Docker on Linux, host access usually works via host.docker.internal
# if compose sets the host-gateway mapping (see infra/docker/docker-compose.flink.yml).
PG_ENABLED=false
PG_JDBC_URL=jdbc:postgresql://host.docker.internal:5432/ai_ops
PG_USER=ai_ops
PG_PASSWORD=changeme
PG_TABLE=event_candidates_v1

# When using psql locally for init:
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_ops
PGUSER=ai_ops
# PGPASSWORD can be set in your shell or in .env (avoid committing secrets)
